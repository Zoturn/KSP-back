# ---------------------------------------------------------------------------
# COPY THIS FILE TO `.env` AND FILL IN REAL VALUES:  cp .env.example .env
#
# `.env` is gitignored (it holds secrets). THIS file is committed so anyone
# cloning the repo knows exactly which variables are required.
#
# Docker Compose automatically reads `.env` from the same folder and substitutes
# ${VAR} references inside docker-compose.yml. NestJS reads the same file through
# @nestjs/config, so the database credentials stay in exactly one place.
# ---------------------------------------------------------------------------

# ---- Application ----------------------------------------------------------
NODE_ENV=development
PORT=3000

# ---- PostgreSQL (consumed by BOTH docker-compose.yml and NestJS) ----------
# Host is `localhost` because Compose publishes the container's port onto your
# machine. (If the API itself later runs inside Compose, this becomes `postgres`
# — the service name — because containers reach each other by service name.)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=ksp_user
POSTGRES_PASSWORD=change_me_local_dev_only
POSTGRES_DB=ksp_ecommerce

# ---- pgAdmin (the browser GUI at http://localhost:5050) -------------------
PGADMIN_DEFAULT_EMAIL=admin@ksp.com
PGADMIN_DEFAULT_PASSWORD=change_me_local_dev_only
PGADMIN_PORT=5050

# ---- JWT (used from Phase 5 onward) ---------------------------------------
# Generate real secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# The access and refresh secrets MUST be different values.
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d
